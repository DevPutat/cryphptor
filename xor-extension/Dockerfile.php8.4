# Cryphptor XOR Extension - PHP 8.4
# Docker image с XOR-расширением для прозрачной расшифровки PHP файлов

FROM php:8.4-cli as builder

# Устанавливаем зависимости для сборки
RUN apt-get update && apt-get install -y \
    && docker-php-source extract \
    && mkdir -p /usr/src/php/ext/xor_decrypt

# Копируем исходный код расширения
COPY php.8.4/xor_decrypt /tmp/xor_decrypt
RUN cp -r /tmp/xor_decrypt/* /usr/src/php/ext/xor_decrypt/

# Собираем расширение
RUN cd /usr/src/php/ext/xor_decrypt \
    && phpize \
    && ./configure \
    && make \
    && make install

# Очищаем
RUN docker-php-source delete


# Runtime image
FROM php:8.4-cli

# Устанавливаем зависимости
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем PHP расширения для Laravel
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath gd zip

# Копируем собранное расширение
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

# Включаем расширение
RUN echo "extension=xor_decrypt.so" > /usr/local/etc/php/conf.d/xor_decrypt.ini

# Копируем вспомогательные скрипты
COPY encrypt.php /usr/local/bin/encrypt-php
COPY xor_autoloader.php /usr/local/share/xor-decrypt/

# Делаем скрипт шифрования исполняемым
RUN chmod +x /usr/local/bin/encrypt-php

# Копируем entrypoint
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Рабочая директория
VOLUME /var/www
WORKDIR /var/www

# Entrypoint
ENTRYPOINT ["docker-entrypoint.sh"]

# Команда по умолчанию
CMD ["php", "-v"]
